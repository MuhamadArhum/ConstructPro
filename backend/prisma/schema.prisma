generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                       String    @id @default(uuid())
  fullName                 String
  email                    String    @unique
  passwordHash             String
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  lastLoginAt              DateTime?
  profilePicturePath       String?
  passwordResetToken       String?
  passwordResetTokenExpiry DateTime?
  lockoutEnd               DateTime?
  accessFailedCount        Int       @default(0)

  roles          UserRole[]
  refreshTokens  RefreshToken[]
  incomes        Income[]
  expenses       Expense[]
  journalEntries JournalEntry[]
  taxRecords     TaxRecord[]
  stockTxns      StockTransaction[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String  @id @default(uuid())
  module      String
  action      String
  code        String  @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id              String    @id @default(uuid())
  userId          String
  token           String    @unique
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  replacedByToken String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Employee {
  id             String          @id @default(uuid())
  code           String?         @unique
  fullName       String
  designation    String?
  department     String?
  phoneNumber    String?
  cnic           String?
  address        String?
  basicSalary    Decimal
  joinDate       DateTime
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  salaryPayments SalaryPayment[]

  @@index([isActive])
  @@map("employees")
}

model SalaryPayment {
  id          String   @id @default(uuid())
  code        String?  @unique
  employeeId  String
  month       Int
  year        Int
  basicSalary Decimal
  bonus       Decimal  @default(0)
  deductions  Decimal  @default(0)
  netSalary   Decimal
  daysPresent Int      @default(0)
  totalDays   Int      @default(30)
  paidAt      DateTime @default(now())
  remarks     String?
  createdAt   DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([year, month])
  @@map("salary_payments")
}

model Labour {
  id                  String             @id @default(uuid())
  code                String?            @unique
  name                String
  phoneNumber         String?
  cnic                String?
  address             String?
  trade               String?
  dailyWage           Decimal
  overtimeRatePerHour Decimal            @default(0)
  joinDate            DateTime
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  attendances         LabourAttendance[]
  advances            LabourAdvance[]
  projectAssignments  ProjectLabour[]

  @@index([isActive])
  @@map("labours")
}

model LabourAttendance {
  id            String   @id @default(uuid())
  labourId      String
  date          DateTime
  isPresent     Boolean  @default(true)
  overtimeHours Decimal  @default(0)
  notes         String?
  labour        Labour   @relation(fields: [labourId], references: [id], onDelete: Cascade)

  @@unique([labourId, date])
  @@index([labourId])
  @@index([date])
  @@map("labour_attendances")
}

model LabourAdvance {
  id       String   @id @default(uuid())
  labourId String
  amount   Decimal
  date     DateTime
  reason   String?
  labour   Labour   @relation(fields: [labourId], references: [id], onDelete: Cascade)

  @@index([labourId])
  @@map("labour_advances")
}

model Customer {
  id           String               @id @default(uuid())
  code         String?              @unique
  name         String
  companyName  String?
  phone        String?
  email        String?
  address      String?
  ntn          String?
  cnic         String?
  projectName  String?
  totalBilled  Decimal              @default(0)
  totalPaid    Decimal              @default(0)
  isActive     Boolean              @default(true)
  notes        String?
  createdAt    DateTime             @default(now())
  transactions CustomerTransaction[]
  projects     Project[]
  invoices     Invoice[]

  @@index([isActive])
  @@index([createdAt])
  @@map("customers")
}

model CustomerTransaction {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String
  amount      Decimal
  date        DateTime
  description String?
  reference   String?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([date])
  @@map("customer_transactions")
}

model Supplier {
  id             String                @id @default(uuid())
  code           String?               @unique
  name           String
  companyName    String?
  phone          String?
  email          String?
  address        String?
  ntn            String?
  category       String?
  totalPurchased Decimal               @default(0)
  totalPaid      Decimal               @default(0)
  isActive       Boolean               @default(true)
  notes          String?
  createdAt      DateTime              @default(now())
  transactions   SupplierTransaction[]
  purchaseOrders PurchaseOrder[]

  @@index([isActive])
  @@index([createdAt])
  @@map("suppliers")
}

model SupplierTransaction {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type        String
  amount      Decimal
  date        DateTime
  description String?
  reference   String?
  createdAt   DateTime @default(now())

  @@index([supplierId])
  @@index([date])
  @@map("supplier_transactions")
}

model Machinery {
  id                  String                 @id @default(uuid())
  code                String?                @unique
  name                String
  model               String?
  serialNumber        String?
  purchaseDate        DateTime?
  purchasePrice       Decimal?
  status              MachineryStatus        @default(Active)
  totalRunningHours   Decimal                @default(0)
  nextMaintenanceDate DateTime?
  notes               String?
  createdAt           DateTime               @default(now())
  maintenanceRecords  MachineryMaintenance[]
  projectAssignments  ProjectMachinery[]

  @@index([status])
  @@map("machineries")
}

enum MachineryStatus {
  Active
  Inactive
  Maintenance
  Retired
}

model MachineryMaintenance {
  id                    String          @id @default(uuid())
  machineryId           String
  maintenanceDate       DateTime
  type                  MaintenanceType
  description           String?
  cost                  Decimal         @default(0)
  runningHoursAtService Decimal?
  nextMaintenanceDate   DateTime?
  serviceProvider       String?
  createdAt             DateTime        @default(now())
  machinery             Machinery       @relation(fields: [machineryId], references: [id], onDelete: Cascade)

  @@index([machineryId])
  @@index([maintenanceDate])
  @@map("machinery_maintenances")
}

enum MaintenanceType {
  Preventive
  Corrective
  Inspection
}

model Vehicle {
  id                  String               @id @default(uuid())
  code                String?              @unique
  registrationNumber  String               @unique
  make                String?
  model               String?
  year                Int?
  driverName          String?
  driverContact       String?
  purchasePrice       Decimal?
  purchaseDate        DateTime?
  status              VehicleStatus        @default(Active)
  totalMileage        Decimal              @default(0)
  nextMaintenanceDate DateTime?
  notes               String?
  createdAt           DateTime             @default(now())
  maintenanceRecords  VehicleMaintenance[]

  @@index([status])
  @@map("vehicles")
}

enum VehicleStatus {
  Active
  Inactive
  Maintenance
}

model VehicleMaintenance {
  id               String    @id @default(uuid())
  vehicleId        String
  maintenanceDate  DateTime
  description      String?
  cost             Decimal   @default(0)
  serviceProvider  String?
  nextDueDate      DateTime?
  mileageAtService Decimal?
  notes            String?
  createdAt        DateTime  @default(now())
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([maintenanceDate])
  @@map("vehicle_maintenances")
}

model Plant {
  id                  String      @id @default(uuid())
  code                String?     @unique
  name                String
  type                String?
  manufacturer        String?
  serialNumber        String?
  purchaseDate        DateTime?
  purchasePrice       Decimal?
  currentValue        Decimal?
  status              PlantStatus @default(Active)
  location            String?
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  notes               String?
  createdAt           DateTime    @default(now())

  @@index([status])
  @@map("plants")
}

enum PlantStatus {
  Active
  Inactive
  Maintenance
  Retired
}

model InventoryItem {
  id                String             @id @default(uuid())
  code              String?            @unique
  name              String
  category          String?
  unit              String?
  currentStock      Decimal            @default(0)
  lowStockThreshold Decimal            @default(0)
  unitPrice         Decimal            @default(0)
  supplierName      String?
  location          String?
  notes             String?
  createdAt         DateTime           @default(now())
  stockTransactions StockTransaction[]

  @@map("inventory_items")
}

model StockTransaction {
  id              String               @id @default(uuid())
  inventoryItemId String
  type            StockTransactionType
  quantity        Decimal
  unitPrice       Decimal?
  date            DateTime
  reference       String?
  projectName     String?
  notes           String?
  createdAt       DateTime             @default(now())
  createdById     String?
  inventoryItem   InventoryItem        @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  createdBy       User?                @relation(fields: [createdById], references: [id])

  @@index([inventoryItemId])
  @@index([date])
  @@map("stock_transactions")
}

enum StockTransactionType {
  In
  Out
  Adjustment
}

model Income {
  id           String         @id @default(uuid())
  code         String?        @unique
  category     IncomeCategory
  amount       Decimal
  date         DateTime
  description  String?
  customerName String?
  projectName  String?
  receiptPath  String?
  isPaid       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  createdById  String?
  createdBy    User?          @relation(fields: [createdById], references: [id])

  @@index([date])
  @@index([category])
  @@map("incomes")
}

enum IncomeCategory {
  CustomerPayment
  ProjectIncome
  OtherIncome
}

model Expense {
  id          String          @id @default(uuid())
  code        String?         @unique
  category    ExpenseCategory
  amount      Decimal
  date        DateTime
  description String?
  vendor      String?
  billPath    String?
  createdAt   DateTime        @default(now())
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id])

  @@index([date])
  @@index([category])
  @@map("expenses")
}

enum ExpenseCategory {
  LabourExpenses
  Salaries
  MachineryMaintenance
  VehicleExpenses
  Fuel
  PlantExpenses
  CarpentryExpenses
  ElectricalExpenses
  SuppliesMaterialPurchase
  OfficeExpenses
  Miscellaneous
}

model ChartOfAccount {
  id          String             @id @default(uuid())
  code        String             @unique
  name        String
  accountType AccountType
  parentId    String?
  isActive    Boolean            @default(true)
  description String?
  createdAt   DateTime           @default(now())
  parent      ChartOfAccount?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    ChartOfAccount[]   @relation("AccountHierarchy")
  journalLines JournalEntryLine[]

  @@map("chart_of_accounts")
}

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense
}

model JournalEntry {
  id          String             @id @default(uuid())
  entryNumber String             @unique
  date        DateTime
  description String?
  reference   String?
  totalDebit  Decimal
  totalCredit Decimal
  isPosted    Boolean            @default(false)
  notes       String?
  createdAt   DateTime           @default(now())
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id])
  lines       JournalEntryLine[]

  @@map("journal_entries")
}

model JournalEntryLine {
  id             String         @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal        @default(0)
  credit         Decimal        @default(0)
  description    String?
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

model TaxRecord {
  id          String    @id @default(uuid())
  code        String?   @unique
  taxType     TaxType
  amount      Decimal
  periodStart DateTime
  periodEnd   DateTime
  dueDate     DateTime?
  paidDate    DateTime?
  isPaid      Boolean   @default(false)
  reference   String?
  description String?
  notes       String?
  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])

  @@index([isPaid])
  @@index([periodStart])
  @@map("tax_records")
}

enum TaxType {
  VAT
  GST
  Income
  Withholding
  Other
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  userId    String?
  entityId  String?
  createdAt DateTime         @default(now())
  readAt    DateTime?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  System
  Alert
  Info
  Warning
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  userEmail    String?
  action       String
  entityType   String?
  entityId     String?
  oldValues    String?
  newValues    String?
  ipAddress    String?
  succeeded    Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([entityType])
  @@map("audit_logs")
}

model CompanySettings {
  id                 String    @id @default(uuid())
  companyName        String    @default("ConstructPro")
  address            String?
  phone              String?
  email              String?
  website            String?
  ntn                String?
  strn               String?
  logoPath           String?
  currency           String    @default("PKR")
  financialYearStart DateTime?
  updatedAt          DateTime  @updatedAt

  @@map("company_settings")
}

model Project {
  id          String    @id @default(uuid())
  code        String?   @unique
  name        String
  description String?
  clientId    String?
  siteAddress String?
  startDate   DateTime
  endDate     DateTime?
  budget      Decimal   @default(0)
  spent       Decimal   @default(0)
  status      String    @default("Planning")
  progress    Int       @default(0)
  managerName String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client         Customer?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  milestones     ProjectMilestone[]
  expenses       ProjectExpense[]
  labours        ProjectLabour[]
  machinery      ProjectMachinery[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@index([clientId])
  @@index([createdAt])
  @@map("projects")
}

model ProjectMilestone {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_milestones")
}

model ProjectExpense {
  id          String   @id @default(uuid())
  projectId   String
  category    String
  amount      Decimal
  date        DateTime
  description String?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_expenses")
}

model ProjectLabour {
  id         String   @id @default(uuid())
  projectId  String
  labourId   String
  assignedAt DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  labour     Labour   @relation(fields: [labourId], references: [id], onDelete: Cascade)

  @@unique([projectId, labourId])
  @@map("project_labours")
}

model ProjectMachinery {
  id          String    @id @default(uuid())
  projectId   String
  machineryId String
  assignedAt  DateTime  @default(now())

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  machinery   Machinery @relation(fields: [machineryId], references: [id], onDelete: Cascade)

  @@unique([projectId, machineryId])
  @@map("project_machineries")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  customerId    String
  projectId     String?
  issueDate     DateTime
  dueDate       DateTime
  status        String        @default("Draft")
  subtotal      Decimal       @default(0)
  taxAmount     Decimal       @default(0)
  total         Decimal       @default(0)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer      Customer      @relation(fields: [customerId], references: [id])
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal  @default(1)
  unitPrice   Decimal  @default(0)
  total       Decimal  @default(0)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  poNumber         String              @unique
  supplierId       String
  projectId        String?
  issueDate        DateTime
  expectedDelivery DateTime?
  status           String              @default("Draft")
  subtotal         Decimal             @default(0)
  taxAmount        Decimal             @default(0)
  total            Decimal             @default(0)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  project          Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items            PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  description     String
  quantity        Decimal       @default(1)
  unitPrice       Decimal       @default(0)
  total           Decimal       @default(0)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}
